{
  "info": {
    "name": "EasyKart database demo",
    "description": "Runs against a local EasyKart server. Creates one demo order and Help message. Set adminPassword privately. No payments are made.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Storage health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Storage is ready', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('Known storage mode', () => pm.expect(['json', 'mongodb']).to.include(pm.response.json().storage));"
            ]
          }
        }
      ]
    },
    {
      "name": "Catalog for demo",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/catalog.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const catalog = pm.response.json();",
              "pm.test('Catalog contains products', () => pm.expect(catalog.length).to.be.above(0));",
              "const items = [{ name: catalog[0].name, quantity: 2, price: 1 }];",
              "pm.collectionVariables.set('cartBody', JSON.stringify({ items }));",
              "pm.collectionVariables.set('expectedTotal', catalog[0].price * 2);",
              "pm.collectionVariables.set('orderBody', JSON.stringify({ items, requestId: pm.variables.replaceIn('{{$guid}}'), customer: { name: 'Demo Shopper', email: 'demo@example.com', address: 'Classroom demonstration address' } }));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin requires authentication",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Start guest session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/cart"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Guest cookie issued', () => pm.expect(pm.cookies.has('ek_visitor')).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sync demo cart",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/cart",
        "body": {
          "mode": "raw",
          "raw": "{{cartBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create demo order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{{orderBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const order = pm.response.json().order; pm.collectionVariables.set('orderId', order.id);",
              "pm.test('Server uses catalog price', () => pm.expect(order.total).to.eql(Number(pm.collectionVariables.get('expectedTotal'))));",
              "pm.test('New demo order', () => pm.expect(order.status).to.eql('New'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Retry without duplication",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{{orderBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Same order returned', () => pm.expect(pm.response.json().order.id).to.eql(pm.collectionVariables.get('orderId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Save demo Help message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/help",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Demo Shopper\",\"email\":\"demo@example.com\",\"message\":\"Please help with this classroom demo order.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/login",
        "body": {
          "mode": "raw",
          "raw": "{{loginBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('loginBody', JSON.stringify({ password: pm.environment.get('adminPassword') || pm.collectionVariables.get('adminPassword') }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read persisted order",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const dashboard = pm.response.json();",
              "pm.test('Order saved', () => pm.expect(dashboard.orders.some(order => order.id === pm.collectionVariables.get('orderId'))).to.eql(true));",
              "pm.test('Help message saved', () => pm.expect(dashboard.help.some(message => message.email === 'demo@example.com')).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update demo order status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/orders/{{orderId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"Packed\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Status persisted', () => pm.expect(pm.response.json().order.status).to.eql('Packed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/logout",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logged-out access is rejected",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
