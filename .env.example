# Copy this file to .env and replace the value with your MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/easykart?retryWrites=true&w=majority
MONGODB_DB_NAME=easykart

# Optional: choose a persistent admin password. Keep this secret and do not commit .env.
# ADMIN_PASSWORD=replace-with-a-long-random-password
